#map ctrl+shift+e open_url_with_hints

# Performance
linux_display_server x11
repaint_delay   10
input_delay     3
sync_to_monitor yes

# Fonts
font_family         Hack Nerd Font Mono
bold_font           auto
italic_font         auto
bold_italic_font    auto
font_size           12.0
force_ltr           no
adjust_line_height  110%
adjust_column_width 0
disable_ligatures   cursor
select_by_word_characters @-./_~?&=%+#

# Mouse 
mouse_hide_wait             3.0
# url_color                 #458588
url_style                   single
open_url_modifiers          kitty_mod
open_url_with               qutebrowser
url_prefixes                http https file ftp gemini
detect_urls                 yes
copy_on_select              kitty_select
strip_trailing_spaces       smart
rectangle_select_modifiers  ctrl+alt
terminal_select_modifiers   shift
select_by_word_characters   @-./_~?&=%+#
click_interval              -1.0
focus_follows_mouse         no
pointer_shape_when_grabbed  arrow
default_pointer_shape       beam
pointer_shape_when_dragging beam


# Cursor 
cursor_shape               beam
cursor_blink_interval      -1
cursor_stop_blinking_after 15.0

# Scrollback
scrollback_lines              2000
scrollback_pager              less --chop-long-lines --RAW-CONTROL-CHARS +INPUT_LINE_NUMBER
scrollback_pager_history_size 0
wheel_scroll_multiplier       5.0
touch_scroll_multiplier       1.0


# Window layout 
remember_window_size       yes
enabled_layouts            tall,stack,fat,grid,splits,horizontal,vertical
window_resize_step_cells   2
window_resize_step_lines   2
window_border_width        1.5pt
draw_minimal_borders       no
window_margin_width        10
single_window_margin_width 0
window_padding_width       7
placement_strategy         center
inactive_text_alpha        0.7
hide_window_decorations    no
resize_debounce_time       0.1
resize_draw_strategy       static
resize_in_steps            no
confirm_os_window_close    1

# tabbar should be at the top
tab_bar_edge top
tab_bar_style separator
tab_separator " ┇"

background_opacity 0.90

# no bells. Ever.
enable_audio_bell no
bell_on_tab no

# Advanced settings
shell                /usr/bin/fish
editor               code
close_on_child_death yes
allow_remote_control yes
listen_on            unix:/tmp/mykitty
clipboard_control    write-clipboard write-primary
allow_hyperlinks     yes
term		     xterm-256color

# Other
disable_ligatures never
font_features none
tab_bar_edge  top
tab_bar_style powerline
# can be one of: angled, slanted, or round
tab_powerline_style slanted
tab_activity_symbol 🔻
dynamic_background_opacity yes
# ✨❗🔥

kitty_mod ctrl+shift

# BEGIN_KITTY_THEME
# Catppuccin-Mocha
include current-theme.conf
# END_KITTY_THEME

