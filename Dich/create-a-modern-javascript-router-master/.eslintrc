{
  "extends": [
    "airbnb",
    "prettier"
  ],
  "plugins": [
    "prettier"
  ],
  "parser": "babel-eslint",
  "rules": {
    "prettier/prettier": [
      "warn",
      {
        "printWidth": 100,
        "singleQuote": true,
        "useTabs": false,
        "tabWidth": 2
      },
      {
        "usePrettierrc": false
      }
    ],
    "max-len": [
      "warn",
      200
    ]
  },
  "env": {
    "browser": true,
    "node": true
  },
  "settings": {
    "import/resolver": {
      "webpack": {
        "config": "./webpack.config.js"
      }
    }
  }
}
